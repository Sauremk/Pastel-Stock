# Plantilla de variables de entorno. Copie este archivo a ".env" (ignorado por Git) y reemplace los valores.
# NUNCA escriba secretos reales en este archivo: solo en ".env" o en el gestor de secretos del proveedor.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=pastel_stock
POSTGRES_USER=pastel
# Genere con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_genere_con_openssl_rand_-base64_24

# --- Aplicación ---
NODE_ENV=production
PORT=3000
APP_VERSION=dev
LOG_LEVEL=info
RUN_MIGRATIONS=true
TRUST_PROXY=1
# Genere con: openssl rand -hex 32   (mínimo 32 caracteres; la API no arranca sin él)
JWT_SECRET=CAMBIAR_genere_con_openssl_rand_-hex_32

# --- Contraseñas iniciales para `npm run seed` (usuarios admin / operador / contador) ---
# Mínimo 12 caracteres. Solo se leen al sembrar los datos de demostración.
SEED_ADMIN_PASSWORD=CAMBIAR_admin_min_12_caracteres
SEED_OPERADOR_PASSWORD=CAMBIAR_operador_min_12_caracteres
SEED_CONTADOR_PASSWORD=CAMBIAR_contador_min_12_caracteres

# --- Desarrollo sin Docker (npm run dev / npm test) ---
# DATABASE_URL=postgres://pastel:<contraseña>@localhost:5432/pastel_stock

# --- Observabilidad (opcional; perfil "obs" de Docker Compose) ---
OTEL_SERVICE_NAME=pastel-stock
# docker-compose.obs.yml ya fija OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 para la API.
# Sin esa variable la API no exporta telemetría. Fuera de Docker: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=0.2
GRAFANA_ADMIN_PASSWORD=CAMBIAR_genere_con_openssl_rand_-base64_24

# --- Pruebas de carga con k6 (nunca contra producción) ---
# TARGET_ENV=local        # local | staging
# TARGET_URL=http://127.0.0.1:3000
# K6_USER=operador
# K6_PASS=
