{
  "name": "pastel-stock",
  "version": "1.4.1",
  "description": "Sistema de inventarios para pastelerías y panaderías (Dulce Hogar). Monolito modular con núcleo hexagonal.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Kevin Andres Rojas Marin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sauremk/Pastel-Stock.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:embedded": "node scripts/dev-embedded.js",
    "lint": "eslint .",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=2 --no-warnings \"tests/**/*.test.js\"",
    "test:unit": "node --test --no-warnings \"tests/unit/**/*.test.js\" \"tests/web/**/*.test.js\" \"tests/pwa/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=2 --no-warnings \"tests/integration/**/*.test.js\"",
    "test:contract": "node --test --no-warnings \"tests/contract/**/*.test.js\"",
    "test:cov": "c8 --all --src=src --reporter=lcov --reporter=text-summary --check-coverage --lines=70 node --test --test-concurrency=2 --no-warnings \"tests/**/*.test.js\"",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/",
    "build:pwa": "node scripts/build-pwa.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-express": "^0.47.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/instrumentation-pg": "^0.50.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "^1.27.2",
    "c8": "^10.1.3",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "supertest": "^7.0.0"
  }
}
