{
 "uid": "pastel-stock-red-slo",
 "title": "Pastel Stock – RED y SLO",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "pastel-stock",
  "slo"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "SLO disponibilidad (30 d) — meta 99,5 %",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:entradas_disponibilidad:ratio_30d",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Presupuesto de error restante",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:entradas_presupuesto_restante:ratio",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "SLO latencia: ventanas con p95 < 300 ms — meta 95 %",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sli:entradas_latencia_cumplimiento:ratio_30d",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.95
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Tasa de error 5xx (5 min)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (sum(rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\"}[5m]))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Tasa de peticiones (req/s) — entradas",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\"}[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Latencia p95 — entradas (umbral 300 ms)",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_bucket{http_route=\"/api/v1/movimientos/entradas\"}[5m])))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "% de errores 5xx — entradas (umbral 1 %)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (sum(rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\"}[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Peticiones por código de estado — entradas",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_count{http_route=\"/api/v1/movimientos/entradas\"}[5m]))",
     "legendFormat": "{{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Latencia p95 por ruta (toda la API)",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket[5m])))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   }
  },
  {
   "id": 10,
   "type": "logs",
   "title": "Errores recientes (Loki)",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=\"pastel-stock\"} |~ \"\\\"level\\\":(\\\"error\\\"|50|60)\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true
   }
  }
 ]
}